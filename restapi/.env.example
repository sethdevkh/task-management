# Copy to .env (gitignored). Fill values from docs/operators.md.
# Do not put demo passwords in images or GitHub workflows.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=taskmgmt
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

DEMO_LEAD_PASSWORD=
DEMO_MEMBER_ALEX_PASSWORD=
DEMO_MEMBER_BAILEY_PASSWORD=

# HS256 signing key, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Browser origin of the web app. Local Vite default is http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
